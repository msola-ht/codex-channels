# Generated by `codexc rules init`.
# Codex loads this file only when this project's `.codex` layer is trusted.

prefix_rule(
    pattern = ["git", ["status", "diff", "log"]],
    decision = "allow",
    justification = "Read-only Git inspection is safe in this project",
    match = [
        "git status",
        "git status -s",
        "git status -sb",
        "git diff",
        "git diff --stat",
        "git diff --cached",
        "git diff --cached --check",
        "git diff --check",
        "git log",
        "git log --oneline",
        "git log -1 --oneline",
        "git log -3 --oneline",
    ],
    not_match = [
        "git add README.md",
        "git commit -m test",
        "git push",
    ],
)

prefix_rule(
    pattern = ["git", ["branch", "remote"]],
    decision = "allow",
    justification = "Read-only branch and remote inspection is safe in this project",
    match = [
        "git branch --list",
        "git branch -a",
        "git remote -v",
    ],
)

prefix_rule(
    pattern = ["codexc", "channel", "send-image"],
    decision = "allow",
    justification = "Send a validated local image to the bound Feishu/WeChat/Telegram conversation through the gateway spool",
    match = [
        "codexc channel send-image",
    ],
    not_match = [
        "codexc channel",
    ],
)

prefix_rule(
    pattern = ["npm", "test"],
    decision = "allow",
    justification = "Run this project's test suite",
    match = [
        "npm test",
        "npm test -- --run tests/example.test.ts",
    ],
    not_match = [
        "npm install",
        "npm publish",
    ],
)

prefix_rule(
    pattern = ["npm", "run", ["build", "check", "docs:check", "lint", "protocol:check", "test:coverage", "test:package", "verify:commit"]],
    decision = "allow",
    justification = "Run a version-controlled project verification script",
    match = [
        "npm run build",
        "npm run check",
        "npm run docs:check",
        "npm run lint",
        "npm run protocol:check",
        "npm run test:coverage",
        "npm run test:package",
        "npm run verify:commit",
    ],
    not_match = [
        "npm run dev",
        "npm run hooks:install",
        "npm run release",
    ],
)
