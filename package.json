{
  "name": "@hegenai/codexc",
  "version": "0.150.1-rc.1",
  "description": "Chat surface gateway for a shared Codex App Server",
  "keywords": [
    "codex",
    "telegram",
    "feishu",
    "gateway",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msola-ht/codex-channels.git"
  },
  "homepage": "https://github.com/msola-ht/codex-channels#readme",
  "bugs": {
    "url": "https://github.com/msola-ht/codex-channels/issues"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "codexc": "bin/codexc.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "src/codex-protocol/version.json",
    "launchd/",
    "runtime/",
    "systemd/",
    "scripts/",
    ".codex/skills/channel-image/",
    "webui/dist/",
    "config.example.toml",
    "index.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "node scripts/prepare-package.mjs",
    "install:global": "node scripts/install-global-source.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "verify:commit": "node scripts/verify-commit.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "version:sync": "node scripts/sync-gateway-version.mjs",
    "check": "tsc -p tsconfig.json --noEmit && node scripts/check-gateway-version.mjs",
    "dev": "tsx src/main.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "webui:dev": "node scripts/webui-dev.mjs",
    "start": "node dist/main.js",
    "test": "npm run build && vitest run --config vitest.config.ts",
    "test:package": "npm run build && node scripts/smoke-package.mjs && node scripts/smoke-source-prepare.mjs",
    "test:watch": "vitest --config vitest.config.ts",
    "codex:upgrade": "node scripts/prepare-codex-upgrade.mjs",
    "codex:upgrade:validate": "node scripts/run-upgrade-validation.mjs",
    "protocol:generate": "node scripts/generate-protocol.mjs",
    "protocol:check": "node scripts/check-protocol.mjs",
    "release:check": "node scripts/check-release-tag.mjs",
    "lint": "eslint src tests bin runtime scripts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@larksuiteoapi/node-sdk": "1.73.0",
    "grammy": "^1.45.1",
    "https-proxy-agent": "^9.1.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "smol-toml": "^1.7.0",
    "undici": "^7.29.0",
    "ws": "^8.18.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "fast-check": "^4.9.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.0.16"
  }
}
