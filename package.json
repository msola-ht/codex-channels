  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "node scripts/prepare-package.mjs",
    "install:global": "node scripts/install-global-source.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "verify:commit": "node scripts/verify-commit.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "version:sync": "node scripts/sync-gateway-version.mjs",
    "check": "tsc -p tsconfig.json --noEmit && node scripts/check-gateway-version.mjs && node scripts/check-runtime-boundaries.mjs",
    "dev": "tsx src/main.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "webui:dev": "node scripts/webui-dev.mjs",
    "start": "node dist/main.js",
    "test": "npm run build && vitest run --config vitest.config.ts",
    "test:package": "npm run build && node scripts/smoke-package.mjs && node scripts/smoke-source-prepare.mjs",
    "test:package:tarball-prepared": "node scripts/smoke-package.mjs",
    "test:watch": "vitest --config vitest.config.ts",
    "codex:upgrade": "node scripts/prepare-codex-upgrade.mjs",
    "codex:upgrade:validate": "node scripts/run-upgrade-validation.mjs",
    "codex:contract:check": "node scripts/codex-public-cli-contract.mjs --check",
    "protocol:generate": "node scripts/generate-protocol.mjs",
    "protocol:check": "node scripts/check-protocol.mjs && npm run codex:contract:check",
    "release:check": "node scripts/check-release-tag.mjs",
    "lint": "eslint src tests bin runtime scripts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@larksuiteoapi/node-sdk": "1.74.0",
